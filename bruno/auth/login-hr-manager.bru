meta {
  name: Login HR Manager
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "hr.manager@beeboard.com",
    "password": "HrManager123!@#$%^&*()_+abcd"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("hrManagerToken", res.body.token);
  }
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should return a JWT token", function() {
    expect(res.body.token).to.be.a('string');
  });
}
