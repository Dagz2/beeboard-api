meta {
  name: Login Invalid Credentials
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "user@beeboard.com",
    "password": "WrongPassword123!@#$%^&*()_+ab"
  }
}

tests {
  test("should return 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });
}
