meta {
  name: Password Reset Request
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/{{apiVersion}}/auth/password-reset/request
  body: json
  auth: none
}

body:json {
  {
    "email": "user@beeboard.com"
  }
}

tests {
  test("should return 200 OK (even if email doesn't exist for security)", function() {
    expect(res.status).to.equal(200);
  });
}
